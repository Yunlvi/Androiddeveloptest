<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#FBF3E4"
                android:endColor="#FFFDF8"
                android:type="linear" />
            <stroke android:width="1dp" android:color="#F2E7D5" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#FFFDF8"
                android:endColor="#FBF3E4"
                android:type="linear" />
            <stroke android:width="1dp" android:color="#F2E7D5" />
        </shape>
    </item>
</selector>
