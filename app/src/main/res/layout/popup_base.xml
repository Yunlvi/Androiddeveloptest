<?xml version="1.0" encoding="utf-8"?>
<!--
  弹窗布局。
  关闭按钮作为白色面板的直接子 View，水平位置天然对齐面板中心；
  gravity=bottom + 负 marginBottom 让它垂直探出面板底边，
  形成"上半嵌入、下半探出"的挖孔效果。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <!-- 顶部橙色装饰条：等比缩放。
             左端星星的一半凸出白面板左边界（图片左外扩 4dp），
             右上角圆角已烘焙进图片素材。 -->
        <FrameLayout
            android:id="@+id/ribbonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/ivRibbon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-10px"
                android:layout_marginEnd="-14px"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:src="@drawable/ic_ribbon_4x"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="标题"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- 橙条与面板之间的透明间隔 -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="6dp" />

        <!-- 白色内容面板 -->
        <FrameLayout
            android:id="@+id/panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="2dp"
            android:minHeight="120dp">

            <LinearLayout
                android:id="@+id/contentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="44dp" />

            <!-- 关闭按钮：panel 的直接子 View。
                 水平：center_horizontal 对齐面板中心（与挖槽同基准）。
                 垂直：bottom + 负 marginBottom = 中心落在面板底边上，
                       下半探出面板（面板已关闭裁切）。 -->
            <LinearLayout
                android:id="@+id/btnClose"
                android:layout_width="140dp"
                android:layout_height="50dp"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="-25dp"
                android:background="@drawable/bg_popup_close"
                android:elevation="0dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="×"
                    android:textColor="#AAAAAA"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="关闭"
                    android:textColor="#666666"
                    android:textSize="15sp" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

</FrameLayout>
