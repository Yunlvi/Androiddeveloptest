<?xml version="1.0" encoding="utf-8"?>
<!--
  设置页：演示 RadioGroup、CheckBox、Spinner 三种备选控件的实际用法。
  每项选择都会真实影响其他页面的行为。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:orientation="vertical">

    <!-- 顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="设置"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_action_settings"
            app:tint="#2B2B2B" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="设置"
            android:textColor="#2B2B2B"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- 主题配色（RadioGroup） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="主题配色"
                    android:textColor="#2B2B2B"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="切换后立即生效，影响导航栏与选中态"
                    android:textColor="#9A9A9A"
                    android:textSize="12sp" />

                <RadioGroup
                    android:id="@+id/rgTheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbWarm"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="暖橙"
                        android:textColor="#444444"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbBlue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="淡蓝"
                        android:textColor="#444444"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbMint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="薄荷"
                        android:textColor="#444444"
                        android:textSize="14sp" />
                </RadioGroup>
            </LinearLayout>

            <!-- 默认账户（Spinner） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="默认账户"
                    android:textColor="#2B2B2B"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="记账页打开时预选的账户"
                    android:textColor="#9A9A9A"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spinnerAccount"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp" />
            </LinearLayout>

            <!-- 提醒设置（CheckBox） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="提醒设置"
                    android:textColor="#2B2B2B"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="可多选，开启后会在首页提示"
                    android:textColor="#9A9A9A"
                    android:textSize="12sp" />

                <CheckBox
                    android:id="@+id/cbDaily"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="每日记账提醒"
                    android:textColor="#444444"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbBig"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="大额支出提醒"
                    android:textColor="#444444"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbMonthly"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="月度报表汇总"
                    android:textColor="#444444"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 当前设置摘要 -->
            <TextView
                android:id="@+id/tvSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="#9A9A9A"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

    <!-- 底部导航条：只保留三个功能项，不含设置按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="150dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_toolbar"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/toolHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_toolbar_item"
                android:gravity="center"
                android:text="⌂"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:background="#4DFFFFFF" />

            <ImageView
                android:id="@+id/toolHelp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_toolbar_item"
                android:contentDescription="帮助"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_action_help"
                app:tint="#FFFFFF" />

            <View
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:background="#4DFFFFFF" />

            <TextView
                android:id="@+id/toolBack"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_toolbar_item"
                android:gravity="center"
                android:text="«"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
